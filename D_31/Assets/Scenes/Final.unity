  m_Script: {fileID: 11500000, guid: ae2aee32154d64432acec6ce7c19d057, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  LastQuestPanel: {fileID: 1902017348}
  CannotRideSpaceShipText: {fileID: 1904336686}
  HeadlinePanel: {fileID: 422175319}
  headlineTypingEffect: {fileID: 799864053}
  headlineSentence: "[\uC18D\uBCF4] \uC778\uB958, \uACE7 \uD654\uC131\uC73C\uB85C
    \uD5A5\uD55C\uB2E4\u2026\n\uC5ED\uC0AC\uC801 \uD654\uC131\uD589 \uC6B0\uC8FC\uC120
    \uBC1C\uC0AC \uC784\uBC15."
  NewsPanel: {fileID: 1099547344}
  anchorAnimator: {fileID: 1099547346}
  newsDialogueTypingEffect: {fileID: 380280970}
  newsDialogueSentences:
  - "\uAD6D\uBBFC \uC5EC\uB7EC\uBD84, \uC548\uB155\uD558\uC2ED\uB2C8\uAE4C."
  - "2049\uB144 12\uC6D4 1\uC77C, \uC624\uB298\uC740 \uC778\uB958 \uC5ED\uC0AC\uC5D0
    \uAE30\uB85D\uB420 '\uD654\uC131\uD589 \uC9C0\uAD6C \uD0C8\uCD9C \uC6B0\uC8FC\uC120
    \uBC1C\uC0AC \uB2F9\uC77C'\uC785\uB2C8\uB2E4."
  - "\uC9C0\uAE08\uC73C\uB85C\uBD80\uD130 \uC815\uD655\uD788 30\uBD84 \uD6C4, \uC778\uB958\uC758
    \uBBF8\uB798\uB97C \uC2E3\uACE0 \uC6B0\uC8FC\uC120\uC774 \uBD89\uC740 \uD589\uC131,\n\uD654\uC131\uC744
    \uD5A5\uD574 \uB0A0\uC544\uC624\uB985\uB2C8\uB2E4."
  - "\uC774\uBC88 \uBC1C\uC0AC\uB294 \uD654\uC131 \uAC70\uC8FC \uAC00\uB2A5\uC131\uC744
    \uAC80\uC99D\uD558\uB294 \uC911\uC694\uD55C \uC2DC\uD5D8\uB300\uC774\uC790,\n\uC778\uB958
    \uC5ED\uC0AC\uC758 \uC0C8\uB85C\uC6B4 \uC7A5\uC744 \uC5EC\uB294 \uC704\uB300\uD55C
    \uCCAB\uAC78\uC74C\uC774 \uB420 \uAC83\uC785\uB2C8\uB2E4."
  - "\uACFC\uC5F0 \uC778\uB958\uB294 \uBBF8\uC9C0\uC758 \uD130\uC804\uC744 \uD5A5\uD574
    \uC131\uACF5\uC801\uC73C\uB85C \uB3C4\uC57D\uD560 \uC218 \uC788\uC744\uC9C0,\n\uC804
    \uC138\uACC4\uC758 \uB208\uC774 \uC774 \uC21C\uAC04\uC5D0 \uC9D1\uC911\uB418\uACE0
    \uC788\uC2B5\uB2C8\uB2E4."
  Ending1Panel: {fileID: 35305369}
  Ending2Panel: {fileID: 1523398493}
  TruthPanel: {fileID: 1018091647}
