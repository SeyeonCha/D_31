  imageObjectB: {fileID: 1581410610}
  scenarioVisuals:
  - sentence: "\uC774\uC81C \uC815\uB9D0 \uB5A0\uB098\uB294\uAC74\uAC00..."
    spriteA: {fileID: 21300000, guid: 28ba171a196d14d22a15357d653f8f0b, type: 3}
    spriteB: {fileID: 21300000, guid: 6fe93dac0c750485d9bf60799054d941, type: 3}
  - sentence: "\uC800\uAE30\uC5D0 \uC788\uB294 \uC0AC\uB78C\uB4E4\uC740 1\uB144 \uB4A4\uC5D0
      \uC8FD\uACA0\uC9C0."
    spriteA: {fileID: 21300000, guid: 905a6cc94f4454c3cb39198c7ded1ade, type: 3}
    spriteB: {fileID: 21300000, guid: 4769c95d46ff4471eb1d25bfb8a01579, type: 3}
  - sentence: "\uD558\uC9C0\uB9CC \uB098\uB294 \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC744\uAC70\uC57C."
    spriteA: {fileID: 21300000, guid: 905a6cc94f4454c3cb39198c7ded1ade, type: 3}
    spriteB: {fileID: 21300000, guid: 4769c95d46ff4471eb1d25bfb8a01579, type: 3}
  - sentence: "[\uC2DC\uC2A4\uD15C]\n\"\uCE74\uC6B4\uD2B8 \uB2E4\uC6B4\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4.\""
    spriteA: {fileID: 21300000, guid: 905a6cc94f4454c3cb39198c7ded1ade, type: 3}
    spriteB: {fileID: 21300000, guid: 4769c95d46ff4471eb1d25bfb8a01579, type: 3}
  - sentence: "[\uC2DC\uC2A4\uD15C]\n\"10, 9, 8, 7, 6\u2026\""
    spriteA: {fileID: 21300000, guid: 2c729497e88ae4bb0b62fe8f2107ea1b, type: 3}
    spriteB: {fileID: 21300000, guid: 60508c1f8897a41d196e768efd8f4087, type: 3}
  - sentence: '!?!?!?'
    spriteA: {fileID: 21300000, guid: 2c729497e88ae4bb0b62fe8f2107ea1b, type: 3}
    spriteB: {fileID: 21300000, guid: 60508c1f8897a41d196e768efd8f4087, type: 3}
  - sentence: "\uD391 -"
    spriteA: {fileID: 21300000, guid: 6dacf75fa18ae4730972578b4d42fc7d, type: 3}
    spriteB: {fileID: 21300000, guid: 6dacf75fa18ae4730972578b4d42fc7d, type: 3}
