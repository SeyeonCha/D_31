MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1004271376}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 46b971227f9894e4481a849c0000efe6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 134614687}
  sentences:
  - "2045\uB144, \uB300\uD55C\uBBFC\uAD6D\uC740 \uC790\uBCF8\uC8FC\uC758\uC640 \uCCA8\uB2E8
    \uACFC\uD559\uAE30\uC220\uC758 \uBE44\uC57D\uC801 \uBC1C\uC804\uC73C\uB85C\n\uB208\uBD80\uC2E0
    \uC131\uC7A5\uC744 \uC774\uB8E8\uC5C8\uB2E4."
  - "\uADF8\uB7EC\uB098 \uADF8 \uBC88\uC601\uC740 \uC77C\uBD80 \uC790\uBCF8\uAC00\uB4E4\uC758
    \uC190\uC5D0\uB9CC \uC950\uC5B4\uC84C\uACE0, \n\uB300\uB2E4\uC218 \uC11C\uBBFC\uB4E4\uC5D0\uAC8C\uB294
    \uC77C\uC790\uB9AC \uC0C1\uC2E4\uACFC \uBD88\uD3C9\uB4F1\uC774\uB77C\uB294 \uC5B4\uB450\uC6B4
    \uADF8\uB9BC\uC790\uB97C \uB0A8\uACBC\uB2E4."
  - "\uC815\uCE58\uC778\uB4E4\uC740 \uC774\uB97C \uC774\uC6A9\uD574 \uBD80\uC790\uC640
    \uBE48\uC790\uB97C \uAC08\uB77C\uC138\uC6B0\uBA70,\n\uC0AC\uD68C\uB294 \uBD84\uC5F4\uACFC
    \uD610\uC624 \uC18D\uC5D0 \uD729\uC2F8\uC600\uB2E4."
  - "\uADF8 \uAC08\uB4F1\uC740 \uACE7 \uBCF4\uC774\uC9C0 \uC54A\uB294 \uACC4\uAE09\uC744
    \uB9CC\uB4E4\uC5C8\uACE0,\n\uC9D1\uAC12\uC744 \uAE30\uC900\uC73C\uB85C \uD55C
    \uAD6C\uC5ED\uD654\uAC00 \uACE0\uCC29\uB418\uC5C8\uB2E4."
  - "\uACB0\uAD6D \uB300\uD55C\uBBFC\uAD6D\uC740 \uB124 \uAC1C\uC758 \uACC4\uAE09
    \uAD6C\uC5ED\uC73C\uB85C \uB098\uB258\uC5C8\uACE0, \n2045\uB144 \uC0AC\uB78C\uB4E4\uC740
    \uADF8 \uCCB4\uC81C\uB97C \u201C\uC2E0\uB300\uD55C\uBBFC\uAD6D\u201D\uC774\uB77C
    \uBD80\uB974\uAC8C \uB418\uC5C8\uB2E4."
  - "\uB2F9\uC2E0\uC740 \uC81C3\uAD6C\uC5ED\uC5D0\uC11C \uC0B4\uC544\uAC00\uB294
    OOO.\n\uC138 \uC0B4 \uC704\uC758 \uB204\uB098\uC640 \uC77C\uACF1 \uC0B4 \uB09C
    \uC870\uCE74\uC640 \n\uD568\uAED8 \uD558\uB8E8\uD558\uB8E8\uB97C \uBC84\uD2F0\uBA70
    \uC0B4\uC544\uAC00\uACE0 \uC788\uB2E4. "
  - "\uADF8\uB7EC\uB358 \uC5B4\uB290 \uB0A0, 2049\uB144.\n\uC138\uC0C1\uC758 \uC885\uB9D0\uC774
    1\uB144\uB3C4 \uCC44 \uB0A8\uC9C0 \uC54A\uC558\uB2E4\uB294 \uBC1C\uD45C\uAC00
    \uB0B4\uB824\uC654\uB2E4. \n\uC815\uBD80\uB294 31\uC77C \uB4A4, \uC778\uB958\uB97C
    \uD654\uC131\uC73C\uB85C \uC774\uC8FC\uC2DC\uD0AC\n\uB9C8\uC9C0\uB9C9 \uC6B0\uC8FC\uC120\uC744
    \uBC1C\uC0AC\uD55C\uB2E4\uACE0 \uBC1D\uD614\uB2E4. "
  - "\uB2E8 \uD55C \uBC88\uC758 \uAE30\uD68C,\n\uADF8\uB7EC\uB098 \uBAA8\uB4E0 \uC774\uAC00
    \uADF8 \uBC30\uC5D0 \uC624\uB97C \uC218 \uC788\uB294 \uAC83\uC740 \uC544\uB2C8\uB2E4.
    \n\uC6B0\uC8FC\uC120\uC5D0 \uD0D1\uC2B9\uD560 \uC790\uACA9\uC744 \uC5BB\uAE30
    \uC704\uD574,\n\uB2F9\uC2E0\uC740 \uC624\uB298\uBD80\uD130 \uB2E8\uC11C\uB97C
    \uCC3E\uC544\uC57C \uD55C\uB2E4."
  - "SNS\uB97C \uD1B5\uD574 \uD769\uC5B4\uC9C4 \uC815\uBCF4\uB97C \uBAA8\uC73C\uACE0,
    \uC0DD\uC874\uC758 \uAE38\uC744 \uC5F4\uC5B4\uB77C. \n\uC791\uC740 \uAE30\uB85D
    \uD558\uB098\uAC00 \uB2F9\uC2E0\uACFC \uAC00\uC871\uC758 \uC6B4\uBA85\uC744 \uAC00\uB97C
    \uAC83\uC774\uB2E4."
  typingSpeed: 0.09
  nextSceneName: ACTA
